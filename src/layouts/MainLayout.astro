---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sparkle Bureaucracy",
  description = "A network prototyping optimistic organisational futures for the age of AI.",
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0e27" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-midnight text-white">
    <header class="border-b border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-4 md:px-12 lg:px-24">
        <div class="flex items-center justify-between gap-4">
          <a href="/" class="font-mono text-xs uppercase tracking-wider text-white/70 md:text-sm">
            Sparkle Bureaucracy · Research Terminal
          </a>
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="h-2 w-2 rounded-full bg-green-400" />
            <span class="font-mono text-xs uppercase tracking-wider text-green-400 md:text-sm">Online</span>
          </div>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-16 border-t border-white/10">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-8 md:px-12 lg:px-24">
        <p class="font-mono text-sm text-white">© 2026 Sparkle Bureaucracy</p>
        <p class="font-mono text-xs text-teal-300/80">Newspeak House · London</p>
      </div>
    </footer>
  </body>
</html>
