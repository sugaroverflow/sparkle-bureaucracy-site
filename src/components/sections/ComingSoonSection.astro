---
import comingSoonData from "@/content/coming-soon.json";

const statusClassMap = {
  upcoming: "text-teal-300",
  planned: "text-pink-400",
  researching: "text-yellow-300",
} as const;
---

<section id="coming-soon" class="section-shell">
  <div class="mb-10">
    <h2 class="section-title">COMING SOON</h2>
    <div class="section-rule" />
  </div>

  <div class="panel border-l-4 border-l-teal-400 p-6 md:p-8">
    <p class="max-w-4xl text-lg leading-relaxed text-white/90">
      {comingSoonData.comingSoonParagraph}
    </p>
    <p class="mt-3 font-mono text-sm uppercase tracking-wide text-teal-300/80">
      Upcoming experiments and events — stay tuned.
    </p>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-3">
    {comingSoonData.experiments.map((item) => (
      <article class="panel border-l-4 border-l-pink-500 p-5">
        <div class="mb-3 flex items-start justify-between gap-3">
          <span class="font-mono text-xs uppercase tracking-wider text-white/60">{item.id}</span>
          <span class={`font-mono text-xs uppercase tracking-wider ${statusClassMap[item.status as keyof typeof statusClassMap]}`}>
            {item.status}
          </span>
        </div>
        <h3 class="text-xl font-bold text-white">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/70">{item.description}</p>
        <p class="mt-4 font-mono text-xs text-white/60">{item.date} · {item.location}</p>
      </article>
    ))}
  </div>
</section>
