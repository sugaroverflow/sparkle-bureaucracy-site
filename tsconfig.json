{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.astro", "src/**/*.ts", "astro.config.mjs"],
  "exclude": ["dist", "polymet-prototype/**"]
}
